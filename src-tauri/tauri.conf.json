{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fanta OFME Downloader",
  "version": "2.5.0-beta.4",
  "identifier": "com.zuhu.fantaofme",
  "build": {
    "frontendDist": "../src/renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Fanta OFME Downloader",
        "width": 1280,
        "height": 840,
        "minWidth": 1000,
        "minHeight": 700,
        "decorations": false,
        "center": true,
        "backgroundColor": "#0a0a0d"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "externalBin": [
      "binaries/bridge_server"
    ],
    "resources": {
      "../src/backend/data/Data.json": "data/Data.json"
    },
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "both",
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFEMUVGQkZCQjRFODc3QzYKUldUR2QraTArL3NlSFJDNDAzYWc2bnhpZVh5Um8wZ2Rrc1JEczVtWDVud1B2NXdsaElVeFhlbisK",
      "endpoints": [
        "https://github.com/ZuhuInc/Simple-OFME-Downloader-LIB/releases/latest/download/latest.json"
      ],
      "allowDowngrades": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
